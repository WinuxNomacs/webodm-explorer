{
  "name": "webodm-explorer-dev",
  "description": "Host-only tests, lint, browser checks and the docs site for the plugin in explorer/ (not part of the plugin zip)",
  "private": true,
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "jest": {
    "roots": [
      "<rootDir>/explorer",
      "<rootDir>/dev"
    ],
    "testEnvironment": "jsdom"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "playwright": "1.64.1",
    "vitepress": "1.6.4"
  }
}
